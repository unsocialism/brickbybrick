{
  "name": "Brick by Brick Reader",
  "short_name": "Brick by Brick",
  "description": "An EPUB and PDF reader that breaks walls of text into short, breathable blocks, with low-contrast tinted themes.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f3e9d8",
  "theme_color": "#f3e9d8",
  "categories": ["books", "education", "productivity"],
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "book", "accept": ["application/epub+zip", "application/x-epub+zip", ".epub", "application/pdf", ".pdf"] }
      ]
    }
  }
}
